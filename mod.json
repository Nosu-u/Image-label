{
	"geode": "6.0.0",
	"gd": {
		"win": "2.2091",
		"android": "2.2091",
		"mac": "2.2091",
		"ios": "2.2091"
	},
	"id": "nosu.image_label",
	"name": "Image Label",
	"version": "v2.0.0",
	"developers": ["Nosu"],
	"description": "Add whatever images you want while playing",
	"dependencies": {
		"geode.node-ids": ">=1.22.0",
		"prevter.imageplus": {
			"version": ">=v1.0.0",
			"required": true
		}
	},
	"settings": {
		"pbutton": {
			"name": "Label editor in pause menu",
			"description": "Show a button to open the label editor in the pause menu",
			"type": "bool",
			"default": true
		},

		"labels-editor": {
      		"type": "custom:labels-editor",
      		"name": "Label editor",
      		"description": "Edit your labels"
    	}
	},

	"tags": [
		"content",
		"universal",
		"offline",
		"interface",
		"customization"
	],

	"links": {
		"source": "https://github.com/Nosu-u/Image-label"
	},

	"resources": {
		"sprites": [
			"resources/*.png"
		]
	}
}
